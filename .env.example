# ==============================================================================
# TV Pirata 🏴‍☠️ — Environment Configuration (.env.example)
# Safe, sanitized defaults with zero embedded credentials
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Network & Server Bindings
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Database Configuration (SQLite default for zero-friction local deployment)
DATABASE_URL=sqlite:///./data/tv_pirata.db

# ------------------------------------------------------------------------------
# Discovery & Metadata External APIs
# ------------------------------------------------------------------------------
# The Movie Database (TMDB) — https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_ACCESS_TOKEN=your_tmdb_read_access_token_here
TMDB_LANGUAGE=pt-BR

# TVMaze API (Public & Open, no key strictly required)
TVMAZE_BASE_URL=https://api.tvmaze.com

# Trakt.tv API (Optional: for scrobbling, global watchlist sync)
TRAKT_CLIENT_ID=your_trakt_client_id_here
TRAKT_CLIENT_SECRET=your_trakt_client_secret_here

# ------------------------------------------------------------------------------
# Home Media & Storage Management (SMB / Network Shares)
# ------------------------------------------------------------------------------
# Path where series/movies are mounted or accessible locally on the host
MEDIA_ROOT_PATH=/mnt/storage/media
SMB_SERIES_PATH=/mnt/storage/media/series
SMB_MOVIES_PATH=/mnt/storage/media/movies

# Network share address for other devices in home LAN (e.g. VLC/Kodi/TV)
SMB_NETWORK_SHARE=smb://192.168.1.100/media

# ------------------------------------------------------------------------------
# SynPraxis AgentOps Platform Configuration
# ------------------------------------------------------------------------------
SPX_WORKSPACE=.
SPX_STORE_DIR=.local/synpraxis
SPX_RAG_ENABLED=True
